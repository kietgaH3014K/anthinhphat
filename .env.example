# ===== Backend (Django) =====
DJANGO_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-50-ky-tu
DJANGO_DEBUG=True
# Khi triển khai thật: DJANGO_DEBUG=False, DB_ENGINE=postgres, DJANGO_SSL_REDIRECT=True
DJANGO_SSL_REDIRECT=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Địa chỉ website công khai, dùng cho sitemap.xml và robots.txt
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Cơ sở dữ liệu: sqlite (dev, không cần cài gì) hoặc postgres (triển khai thật)
DB_ENGINE=sqlite

# Chỉ cần khi DB_ENGINE=postgres
POSTGRES_DB=anthinhphat
POSTGRES_USER=atp_user
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Lưu ảnh (để trống = lưu local khi dev; điền Cloudinary khi triển khai)
CLOUDINARY_URL=

# ===== Frontend (Vite) – chỉ đặt giá trị CÔNG KHAI, không đặt khóa bí mật =====
VITE_API_URL=http://localhost:8000/api/v1
VITE_HOTLINE=
VITE_ZALO=
# Mặc định dùng API thật. Đặt true nếu chỉ muốn xem giao diện bằng dữ liệu mẫu, không cần backend
VITE_USE_MOCK=false
# Google Analytics 4 (tùy chọn), ví dụ G-XXXXXXXXXX
VITE_GA_ID=
